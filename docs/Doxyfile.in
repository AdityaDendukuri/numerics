PROJECT_NAME           = "numerics"
PROJECT_BRIEF          =
OUTPUT_DIRECTORY       = @CMAKE_CURRENT_BINARY_DIR@

# ── Sources ──────────────────────────────────────────────────────────────────
# Include the library headers, the pages directory, and each app's README.md.
INPUT                  = @CMAKE_SOURCE_DIR@/include        \
                         @CMAKE_SOURCE_DIR@/docs/pages     \
                         @CMAKE_SOURCE_DIR@/examples
FILE_PATTERNS          = *.hpp *.h *.md *.cpp
EXAMPLE_PATH           = @CMAKE_SOURCE_DIR@/examples
EXAMPLE_RECURSIVE      = YES
IMAGE_PATH             = @CMAKE_SOURCE_DIR@/docs/pages
RECURSIVE              = YES
# Exclude build artefacts and test/benchmark source files
EXCLUDE_PATTERNS       = */build/* */_deps/* */tests/* */benchmarks/*

# ── Extraction ────────────────────────────────────────────────────────────────
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = YES

# ── Output ────────────────────────────────────────────────────────────────────
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
GENERATE_MAN           = YES
MAN_OUTPUT             = man
MAN_EXTENSION          = .3
MAN_SUBDIR             = man3
MAN_LINKS              = YES
HTML_OUTPUT            = html
QUIET                  = YES
SEARCHENGINE           = YES
GENERATE_TAGFILE       = @CMAKE_CURRENT_BINARY_DIR@/numerics.tag

# ── Markdown ─────────────────────────────────────────────────────────────────
MARKDOWN_SUPPORT       = YES
# Allow $...$ and $$...$$ math in Markdown files (Doxygen ≥ 1.9.4)
MARKDOWN_ID_STYLE      = GITHUB

# ── Math rendering ────────────────────────────────────────────────────────────
# Render \f[...\f] and $$...$$ with MathJax (no local LaTeX required).
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
MATHJAX_FORMAT         = HTML-CSS
MATHJAX_EXTENSIONS     = TeX/AMSmath TeX/AMSsymbols

# ── Navigation ────────────────────────────────────────────────────────────────
# Make index.md the Doxygen start page.
USE_MDFILE_AS_MAINPAGE = @CMAKE_SOURCE_DIR@/docs/pages/index.md
GENERATE_TREEVIEW       = YES
DISABLE_INDEX           = NO
FULL_SIDEBAR            = YES
TREEVIEW_WIDTH          = 280
TOC_INCLUDE_HEADINGS    = 2
LAYOUT_FILE             = @CMAKE_SOURCE_DIR@/docs/DoxygenLayout.xml
GENERATE_TODOLIST       = NO

# ── HTML theme (doxygen-awesome + github primer light & dark) ──────────────────
HTML_HEADER            = @CMAKE_SOURCE_DIR@/docs/header.html
HTML_EXTRA_STYLESHEET  = @CMAKE_SOURCE_DIR@/docs/doxygen-awesome.css \
                         @CMAKE_SOURCE_DIR@/docs/custom-github-dark.css
HTML_EXTRA_FILES       = @CMAKE_SOURCE_DIR@/docs/doxygen-awesome-darkmode-toggle.js
