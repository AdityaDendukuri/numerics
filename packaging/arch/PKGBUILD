# Maintainer: Aditya Dendukuri <dendukuri.aditya123@outlook.com>
pkgname=numerics
pkgver=1.2.0
pkgrel=1
pkgdesc="Header-only C++20 library for scientific computing"
arch=('any')
url="https://github.com/AdityaDendukuri/numerics"
license=('MIT')
makedepends=('cmake')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cmake -S "$pkgname-$pkgver" -B build -DCMAKE_INSTALL_PREFIX=/usr \
    -DNUMERICS_BUILD_EXAMPLES=OFF \
    -DNUMERICS_ENABLE_CUDA=OFF -DNUMERICS_ENABLE_MPI=OFF \
    -DNUMERICS_USE_BLAS=OFF -DNUMERICS_USE_LAPACK=OFF -DNUMERICS_USE_OPENMP=OFF
   
}

package() {
  DESTDIR="$pkgdir" cmake --install build
  install -Dm644 "$pkgname-$pkgver/LICENSE" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
