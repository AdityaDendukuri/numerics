Checks: >
  -*,
  bugprone-*,-bugprone-easily-swappable-parameters,-bugprone-exception-escape,
  cppcoreguidelines-pro-type-member-init,
  cppcoreguidelines-slicing,
  cppcoreguidelines-prefer-member-initializer,
  -bugprone-easily-swappable-parameters,
  performance-*,
  readability-braces-around-statements,
  readability-const-return-type,
  readability-container-size-empty,
  readability-redundant-smartptr-get,
  readability-math-missing-parentheses,
  readability-identifier-naming,
  modernize-use-nullptr,
  modernize-use-override,
  modernize-use-nodiscard,
  clang-analyzer-*

WarningsAsErrors: ""

HeaderFilterRegex: ".*/numerics/(include|src)/.*"
ExcludeHeaderFilterRegex: ".*/(build|third_party|_deps)/.*"

CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.MethodCase
    value: lower_case
  - key: readability-identifier-naming.ParameterCase
    # Function parameters include conventional matrix notation (A, B, C).
    # Local variables remain subject to lower_case below.
    value: aNy_CasE
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  # Uppercase one-letter names are conventional for matrices/operators in
  # numerical linear algebra (A, B, C, L, R, ...).
  - key: readability-identifier-naming.VariableIgnoredRegexp
    value: '^[A-Z][0-9]*$'
